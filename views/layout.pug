doctype html
html
  head
    title= `${title}`
    style.
      body { font-family: sans-serif; padding: 20px; }
      ul { color: red; list-style-type: none; padding: 0; }
      li { margin-bottom: 5px; }
      form { margin-top: 15px; }
      label { display: block; margin-top: 10px; font-weight: bold; }
      input[type="text"], input[type="email"] { width: 250px; padding: 5px; margin-top: 5px; }
      input[type="submit"] { display: block; margin-top: 15px; padding: 5px 15px; }
  body
    h1 My Amazing App
    block content